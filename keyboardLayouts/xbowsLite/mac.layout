# Mac X-Bows Lite layout: factory defaults plus these changes.
# Apply:  ./xbows.py apply mac.layout     (switch back: ./xbows.py apply linux.layout)
#
# Special slots (found by probing, factory value d0 a2 xx):
#   @39 middle backspace   @40 middle enter   @35 middle ctrl
#   @41 middle shift       @53 right space    @29 left space (plain space)
#   @17 small key left of left space (plain Left Alt = Option on Mac)
@29 = lalt    # left spacebar          -> Left Option
@17 = space   # small key left of it   -> Space (swapped with the left spacebar)
@35 = lgui    # middle ctrl   -> Super / Cmd
@41 = esc     # middle shift  -> Escape
